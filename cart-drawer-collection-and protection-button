<div class="complete-your-setup">
  <h3 class="section-title">Customers also add ...</h3>

  <!-- Shipping Protection Section -->
  {% assign shipping_protection = all_products['shipping-protection'] %}
  {% if shipping_protection %}
    <div class="shipping-protection-item">
      <div class="protection-icon">
       <img src="https://cdn.shopify.com/s/files/1/0940/8407/1754/files/SHIPPINGPROTECTIONLOGO.webp?v=1763026885">
      </div>
      
      <div class="protection-details">
        <h4 class="protection-title">{{ shipping_protection.title }}</h4>
        <p class="protection-subtitle">Protect your order from damage, loss, or theft during shipping</p>
      </div>
      
      <div class="protection-price-toggle">
        <span class="protection-price">{{ shipping_protection.price | money }}</span>
        <label class="toggle-switch">
          <input 
            type="checkbox" 
            id="shipping-protection-toggle" 
            data-variant-id="{{ shipping_protection.variants.first.id }}"
          >
          <span class="toggle-slider"></span>
        </label>
      </div>
    </div>
  {% endif %}

  <!-- Regular Products Section -->
  {% assign collection = collections[settings.showcollection] %}
  {% if collection and collection.products.size > 0 %}
    <div class="product-list">
      {% for product in collection.products limit: 4 %}
        <div class="product-item" data-product-id="{{ product.id }}">
          <a href="{{ product.url }}" class="product-image">
            {% if product.featured_image %}
              <img src="{{ product.featured_image | img_url: '200x' }}" alt="{{ product.title }}">
            {% endif %}
          </a>
          
          <div class="product-details">
            <h4 class="product-title">{{ product.title }}</h4>
            <p class="product-subtitle">For Lovely Nights With Your Partner</p>
            
            {% if product.tags contains 'best-seller' or forloop.index <= 2 %}
              <span class="best-seller-badge">★ BEST SELLER</span>
            {% endif %}
          </div>
          
          <button
            class="add-to-cart-btn"
            data-variant-id="{{ product.variants.first.id }}"
            aria-label="Add to cart"
          >
            Add • {{ product.price | money }}
          </button>
        </div>
      {% endfor %}
    </div>
  {% endif %}
</div>

<style>
.complete-your-setup {
  max-width: 500px;
  margin: 2rem auto;
  padding: 0 20px;
  position: static;
}

.complete-your-setup .section-title {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif;
  font-weight: 600;
  font-size: 18px;
  color: #000000;
  margin-bottom: 1.5rem;
}

/* Shipping Protection Styles */
.shipping-protection-item {
  display: flex;
  align-items: center;
  gap: 1rem;
  padding: 1rem;
  margin-bottom: 1.5rem;

  position: relative;
}

.protection-icon {
  flex-shrink: 0;
  width: 50px;
  height: 50px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: white;
  border-radius: 10px;
}

.protection-icon svg {
  width: 28px;
  height: 28px;
}

.protection-details {
  flex: 1;
  min-width: 0;
}

.protection-title {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif;
  font-weight: 600;
  font-size: 14px;
  color: #000000;
  margin: 0 0 0.25rem 0;
  line-height: 1.3;
}

.protection-subtitle {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif;
  font-size: 11px;
  color: #666666;
  margin: 0;
  line-height: 1.4;
}

.protection-price-toggle {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 0.5rem;
}

.protection-price {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif;
  font-weight: 600;
  font-size: 14px;
  color: #000000;
}

/* Toggle Switch */
.toggle-switch {
  position: relative;
  display: inline-block;
  width: 44px;
  height: 24px;
}

.toggle-switch input {
  opacity: 0;
  width: 0;
  height: 0;
}

.toggle-slider {
  position: absolute;
  cursor: pointer;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: #ccc;
  transition: 0.3s;
  border-radius: 24px;
}

.toggle-slider:before {
  position: absolute;
  content: "";
  height: 18px;
  width: 18px;
  left: 3px;
  bottom: 3px;
  background-color: white;
  transition: 0.3s;
  border-radius: 50%;
}

.toggle-switch input:checked + .toggle-slider {
  background-color: #000000;
}

.toggle-switch input:checked + .toggle-slider:before {
  transform: translateX(20px);
}

/* Products List */
.complete-your-setup .product-list {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.complete-your-setup .product-item {
  display: flex;
  align-items: center;
  gap: 1rem;
  padding: 0.5rem 0;
  border-bottom: 1px solid #e5e5e5;
  position: relative;
}

.complete-your-setup .product-item:last-child {
  border-bottom: none;
}

.complete-your-setup .product-image {
  flex-shrink: 0;
  width: 80px;
  height: 80px;
  display: block;
  position: static;
}

.complete-your-setup .product-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  border-radius: 8px;
}

.complete-your-setup .product-details {
  flex: 1;
  min-width: 0;
}

.complete-your-setup .product-title {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif;
  font-weight: 600;
  font-size: 14px;
  color: #000000;
  margin: 0 0 0.25rem 0;
  line-height: 1.3;
}

.complete-your-setup .product-subtitle {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif;
  font-size: 12px;
  color: #666666;
  margin: 0 0 0.5rem 0;
  line-height: 1.3;
}

.complete-your-setup .best-seller-badge {
  display: inline-block;
  font-size: 10px;
  font-weight: 600;
  color: #000000;
  letter-spacing: 0.5px;
  position: absolute;
  right: 7px;
  background-color: #8080801a;
  top: 0px;
  padding: 2px 6px;
  border-radius: 4px;
}

.complete-your-setup .add-to-cart-btn {
  flex-shrink: 0;
  background: #000000;
  color: #ffffff;
  border: none;
  border-radius: 20px;
  padding: 8px 16px;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif;
  font-weight: 600;
  font-size: 13px;
  cursor: pointer;
  transition: background 0.2s;
  white-space: nowrap;
}

.complete-your-setup .add-to-cart-btn:hover {
  background: #333333;
}

.complete-your-setup .add-to-cart-btn:active {
  transform: scale(0.98);
}

.drawer__footer {
  padding-inline: 20px;
}

.cart__savings-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8px;
  justify-content: center;
  padding-top: 8px;
}

svg.bi.bi-stars {
  fill: white;
  margin-top: -5px;
  margin-bottom: -6px;
}

.social-proof-bar {
  background-color: #211a28;
  padding: 5px 15px;
  text-align: center;
}
.protection-title {
    font-family: 'Bricolage Grotesque';
    font-weight: 600;
    font-size: 17px;
    color: #000000;
    margin: 0 0 0.25rem 0;
    line-height: 1.3;
    letter-spacing: normal;
}
@media (max-width: 480px) {
  .shipping-protection-item {
    gap: 0.75rem;
    padding: 0.75rem;
  }
  
  .protection-icon {
    width: 40px;
    height: 40px;
  }
  
  .protection-icon svg {
    width: 24px;
    height: 24px;
  }
  
  .protection-title {
    font-size: 13px;
  }
  
  .protection-subtitle {
    font-size: 10px;
  }
  
  .protection-price {
    font-size: 13px;
  }
  
  .complete-your-setup .product-image {
    width: 60px;
    height: 60px;
  }
  
  .complete-your-setup .product-title {
    font-size: 13px;
  }
  
  .complete-your-setup .add-to-cart-btn {
    font-size: 12px;
    padding: 6px 12px;
  }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  let isShippingProtectionInCart = false;
  
  // Check if shipping protection is already in cart on load
  function checkShippingProtectionInCart() {
    fetch('/cart.js')
      .then(res => res.json())
      .then(cart => {
        const protectionToggle = document.getElementById('shipping-protection-toggle');
        if (!protectionToggle) return;
        
        const variantId = protectionToggle.dataset.variantId;
        const protectionItem = cart.items.find(item => item.variant_id == variantId);
        
        isShippingProtectionInCart = !!protectionItem;
        protectionToggle.checked = isShippingProtectionInCart;
      })
      .catch(err => console.error('Error checking cart:', err));
  }
  
  // Handle shipping protection toggle
  function handleShippingProtectionToggle() {
    const toggle = document.getElementById('shipping-protection-toggle');
    if (!toggle) return;
    
    toggle.addEventListener('change', function() {
      const variantId = this.dataset.variantId;
      const isChecked = this.checked;
      
      if (isChecked && !isShippingProtectionInCart) {
        // Add to cart
        fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: variantId, quantity: 1 })
        })
        .then(res => res.json())
        .then(() => {
          isShippingProtectionInCart = true;
          updateCartDrawer();
        })
        .catch(err => {
          console.error('Add to cart error:', err);
          this.checked = false;
        });
      } else if (!isChecked && isShippingProtectionInCart) {
        // Remove from cart
        fetch('/cart.js')
          .then(res => res.json())
          .then(cart => {
            const protectionItem = cart.items.find(item => item.variant_id == variantId);
            if (protectionItem) {
              return fetch('/cart/change.js', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id: protectionItem.key, quantity: 0 })
              });
            }
          })
          .then(() => {
            isShippingProtectionInCart = false;
            updateCartDrawer();
          })
          .catch(err => {
            console.error('Remove from cart error:', err);
            this.checked = true;
          });
      }
    });
  }
  
  // Update cart drawer
  function updateCartDrawer() {
    fetch('/cart?section_id=cart-drawer')
      .then(r => r.text())
      .then(html => {
        const parser = new DOMParser();
        const doc = parser.parseFromString(html, 'text/html');
        const newDrawer = doc.querySelector('.cart-drawer');
        const currentDrawer = document.querySelector('.cart-drawer');
        if (newDrawer && currentDrawer) {
          currentDrawer.innerHTML = newDrawer.innerHTML;
        }
        initCompleteYourSetup();
      })
      .catch(err => console.error('Update cart drawer error:', err));
  }
  
  // Handle regular product add to cart
  function initProductButtons() {
    const wrapper = document.querySelector('.complete-your-setup');
    if (!wrapper) return;

    wrapper.querySelectorAll('.add-to-cart-btn').forEach(btn => {
      const newBtn = btn.cloneNode(true);
      btn.parentNode.replaceChild(newBtn, btn);
      
      newBtn.addEventListener('click', e => {
        e.preventDefault();
        const variantId = newBtn.dataset.variantId;
        
        fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: variantId, quantity: 1 })
        })
        .then(res => res.json())
        .then(() => {
          updateCartDrawer();
        })
        .catch(err => console.error('Add to cart error:', err));
      });
    });
  }
  
  function initCompleteYourSetup() {
    checkShippingProtectionInCart();
    handleShippingProtectionToggle();
    initProductButtons();
  }
  
  initCompleteYourSetup();
});
</script>
